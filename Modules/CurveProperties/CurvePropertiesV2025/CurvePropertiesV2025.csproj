<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CurveProperties</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">   
   <OutDir>$(SolutionDir)$(SolutionName).bundle\contents\</OutDir>
   <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
   <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
</PropertyGroup>


<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
   <OutDir>$(SolutionDir)bin\Debug\</OutDir>
   <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
   <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
</PropertyGroup>


<ItemGroup>
  <None Remove="Base\.keep" />
</ItemGroup>


<ItemGroup>
  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\AddButtons.cs" Link="Base\AddButtons.cs" />
  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\BaseGeometryClass.cs" Link="Base\BaseGeometryClass.cs" />
  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\BaseGetObjectClass.cs" Link="Base\BaseGetObjectClass.cs" />
  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\BaseWPF.cs" Link="Base\BaseWPF.cs" />
  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\BaseXMLClass.cs" Link="Base\BaseXMLClass.cs" />
  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\ControlVersionClass.cs" Link="Base\ControlVersionClass.cs" />
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" />
    <PackageReference Include="Digi-Ants.AutoCAD.API.MPolygon" Version="2025.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ArxBridge">
      <HintPath>..\..\..\bin\Debug_2025\ArxBridge.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

<Target Name="CreatePackageContents" AfterTargets="Build" Condition=" '$(Configuration)' == 'Release' ">
  <PropertyGroup>
    <!-- Путь к папке бандла в корне решения -->
    <BundleDir>$(SolutionDir)$(SolutionName).bundle\</BundleDir>
    <ManifestPath>$(BundleDir)PackageContents.xml</ManifestPath>
    
    <!-- Генерируем новый случайный GUID для ProductCode при каждой сборке релиза -->
    <ProductCodeGuid>$([System.Guid]::NewGuid().ToString("B"))</ProductCodeGuid>
  </PropertyGroup>

  <!-- Создаем саму папку .bundle, если её ещё нет -->
  <MakeDir Directories="$(BundleDir)" Condition="!Exists('$(BundleDir)')" />

  <!-- Генерируем структуру PackageContents.xml с подстановкой имени нового решения -->
    
<WriteLinesToFile File="$(ManifestPath)" Overwrite="true" Encoding="utf-8" Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot; ?&gt;&#xD;&#xA;&lt;ApplicationPackage SchemaVersion=&quot;1.0&quot; AppVersion=&quot;1.0&quot;&#xD;&#xA;                    ProductCode=&quot;$(ProductCodeGuid)&quot;&#xD;&#xA;                    Name=&quot;$(SolutionName)&quot;&gt;&#xD;&#xA;&#xD;&#xA;  &lt;CompanyDetails Name=&quot;zzz&quot; Email=&quot;alzslnc@gmail.com&quot;/&gt;&#xD;&#xA;&#xD;&#xA;  &lt;Components Description=&quot;ACad 2024-&quot; Platform=&quot;ACAD | Civil3D&quot;&gt;&#xD;&#xA;    &lt;RuntimeRequirements OS=&quot;Win64&quot; SeriesMax=&quot;24.3&quot;/&gt;&#xD;&#xA;    &lt;ComponentEntry&#xD;&#xA;      ModuleName=&quot;./Contents/$(SolutionName)V2024.dll&quot;&#xD;&#xA;    /&gt;&#xD;&#xA;  &lt;/Components&gt;&#xD;&#xA;&#xD;&#xA;  &lt;Components Description=&quot;ACad 2025-2026&quot; Platform=&quot;ACAD | Civil3D&quot;&gt;&#xD;&#xA;    &lt;RuntimeRequirements OS=&quot;Win64&quot; SeriesMin=&quot;25.0&quot; SeriesMax=&quot;25.1&quot;/&gt;&#xD;&#xA;    &lt;ComponentEntry&#xD;&#xA;      ModuleName=&quot;./Contents/$(SolutionName)V2025.dll&quot;&#xD;&#xA;    /&gt;&#xD;&#xA;  &lt;/Components&gt;&#xD;&#xA;&#xD;&#xA;  &lt;Components Description=&quot;ACad 2027+&quot; Platform=&quot;ACAD | Civil3D&quot;&gt;&#xD;&#xA;    &lt;RuntimeRequirements OS=&quot;Win64&quot; SeriesMin=&quot;26.0&quot;/&gt;&#xD;&#xA;    &lt;ComponentEntry&#xD;&#xA;      ModuleName=&quot;./Contents/$(SolutionName)V2027.dll&quot;&#xD;&#xA;    /&gt;&#xD;&#xA;  &lt;/Components&gt;&#xD;&#xA;&#xD;&#xA;&lt;/ApplicationPackage&gt;" />
  
</Target>

</Project>