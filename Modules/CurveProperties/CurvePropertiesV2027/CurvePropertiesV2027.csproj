  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\BaseWPF.cs" Link="Base\BaseWPF.cs" />
  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\BaseXMLClass.cs" Link="Base\BaseXMLClass.cs" />
  <Compile Include="..\..\..\..\BaseFunction\BaseClasses\ControlVersionClass.cs" Link="Base\ControlVersionClass.cs" />
  <Compile Include="..\CurvePropertiesV2025\App\AppConstants.cs" Link="App\AppConstants.cs" />
  <Compile Include="..\CurvePropertiesV2025\App\ExtensionApplication.cs" Link="App\ExtensionApplication.cs" />
  <Compile Include="..\CurvePropertiesV2025\CurvePropertiesDataClass.cs" Link="CurvePropertiesDataClass.cs" />
  <Compile Include="..\CurvePropertiesV2025\Ribbon\Commands.cs" Link="Ribbon\Commands.cs" />
